generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int                @id @default(autoincrement())
  email        String             @unique
  passwordHash String
  displayName  String
  role         Role
  createdAt    DateTime           @default(now())

  sessions     Session[]
  templates    ActivityTemplate[]
  goals        Goal[]
  entryRevisions ActivityEntryRevision[]

  @@map("users")
}

enum Role {
  PARTICIPANT
  PROGRAM_MANAGER
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ActivityTemplate {
  id          Int            @id @default(autoincrement())
  name        String
  unit        String
  minValue    Float
  maxValue    Float
  status      TemplateStatus @default(DRAFT)
  createdById Int
  createdAt   DateTime       @default(now())

  createdBy   User           @relation(fields: [createdById], references: [id])
  goals       Goal[]

  @@map("activity_templates")
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
}

model Goal {
  id            Int             @id @default(autoincrement())
  participantId Int
  templateId    Int
  dailyTarget   Float
  status        GoalStatus      @default(ACTIVE)
  createdAt     DateTime        @default(now())

  participant   User            @relation(fields: [participantId], references: [id], onDelete: Cascade)
  template      ActivityTemplate @relation(fields: [templateId], references: [id])
  entries       ActivityEntry[]

  @@map("goals")
}

enum GoalStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model ActivityEntry {
  id        Int      @id @default(autoincrement())
  goalId    Int
  entryDate String
  value     Float
  note      String?
  createdAt DateTime @default(now())
  // Lab 7 CR #99 (F-04 v1.2 §3): null until the first correction. Deliberately not @updatedAt,
  // which would also be set when the entry is created.
  updatedAt DateTime?
  // Number of corrections; optimistic concurrency check for BR-13(b). Existing rows get 0.
  version   Int      @default(0)

  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  revisions ActivityEntryRevision[]

  @@unique([goalId, entryDate])
  @@map("activity_entries")
}

// Lab 7 CR #99 (FR-15, FR-16): one stored correction of an activity entry.
// Invariant: an entry has exactly `version` revisions.
model ActivityEntryRevision {
  id            Int      @id @default(autoincrement())
  entryId       Int
  previousValue Float
  newValue      Float
  previousNote  String?
  newNote       String?
  reason        String
  changedById   Int
  changedAt     DateTime @default(now())

  entry     ActivityEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  changedBy User          @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([entryId, changedAt])
  @@map("activity_entry_revisions")
}
