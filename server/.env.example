# Environment variables for habit-tracker server
# Copy this file to .env and adjust values for your local environment.
# Never commit real passwords or production credentials to Git.

# Port the API listens on. Cloud Run sets PORT itself (3000 in our image).
PORT=3000

# Database connection. Secret: in the cloud it comes from Secret Manager
# (sf4618437-database-url), never from a file.
DATABASE_URL="postgresql://habittracker:habittracker@localhost:5432/habittracker?schema=public"

# Separate database for the automated tests (local and CI only; must differ from DATABASE_URL).
DATABASE_URL_TEST="postgresql://habittracker:habittracker@localhost:5432/habittracker_test?schema=public"

# How long a sign-in session lasts, in hours (default 24).
SESSION_TTL_HOURS=24
TZ="Asia/Bangkok"

# Runtime mode. Leave unset locally (development). The container and Cloud Run use
# "production": the session cookie becomes Secure and Express serves the built client.
# NODE_ENV=development

# Folder of the built client (optional). Default: <repo>/client/dist.
# CLIENT_DIST_DIR=

# Seed passwords (read by seed.ts, hashed with bcryptjs). Secret: in the cloud they
# come from Secret Manager (team app-secret slots), never from a file.
SEED_MANAGER_PASSWORD="change-me-manager-password"
SEED_PARTICIPANT_PASSWORD="change-me-participant-password"
