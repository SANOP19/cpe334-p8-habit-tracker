# Environment variables for habit-tracker server
# Copy this file to .env and adjust values for your local environment.
# Never commit real passwords or production credentials to Git.

PORT=3000
DATABASE_URL="postgresql://habittracker:habittracker@localhost:5432/habittracker?schema=public"
SESSION_TTL_HOURS=24
TZ="Asia/Bangkok"

# Seed passwords (read by seed.ts, hashed with bcryptjs)
SEED_MANAGER_PASSWORD="change-me-manager-password"
SEED_PARTICIPANT_PASSWORD="change-me-participant-password"
