# Environment variables for Docker Compose (local container stack only).
# Copy this file to .env at the repo root before running `docker compose up --build -d`.
# Never commit real passwords or production credentials to Git.

POSTGRES_USER=habittracker
POSTGRES_PASSWORD=habittracker
POSTGRES_DB=habittracker
# Optional host port override if 5432 is already in use locally (default 5432).
# POSTGRES_PORT=5432
# Optional host port for the app if 3000 is already in use locally (default 3000).
# APP_PORT=3000

SESSION_TTL_HOURS=24

# Required by the migrate/seed container (no default fallback in docker-compose.yml).
SEED_MANAGER_PASSWORD=change-me-manager-password
SEED_PARTICIPANT_PASSWORD=change-me-participant-password
