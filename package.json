{
  "name": "habit-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:server": "npm test --prefix server",
    "test:client": "npm test --prefix client",
    "test:e2e": "playwright test",
    "test": "npm run test:server && npm run test:client && npm run test:e2e",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:server && npm run build:client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "migrate": "npm --prefix server run migrate",
    "migrate:test": "npm --prefix server run migrate:test",
    "seed": "npm run seed --prefix server",
    "test:restart": "node scripts/verify-nfr04-restart.cjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
